# ── Banco de dados ────────────────────────────────────────
POSTGRES_DB=inventory_control
POSTGRES_USER=inventory_user
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Django ────────────────────────────────────────────────
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Hosts separados por vírgula. Ex: meucliente.gerenciar.app
ALLOWED_HOSTS=localhost,127.0.0.1

# URLs do frontend separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Deployment ────────────────────────────────────────────
# Repositório GitHub no formato owner/repo (usado para o registry de imagens)
GITHUB_REPOSITORY=seu-usuario/Inventory-Control

# Tag da imagem a ser usada (preenchida automaticamente pelo CI/CD)
IMAGE_TAG=latest
